{
  "name": "gerdau_mais_automation",
  "version": "1.0.0",
  "description": "Testes automatizados E2E para Gerdau Mais",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:fast": "cypress run --config video=false",
    "cy:run:headed": "cypress run --headed --browser chrome",
    "cy:run:headed:fast": "cypress run --headed --browser chrome --config video=false",
    "cy:run:smoke": "npm run cy:run:smoke-pr",
    "cy:run:regression": "npm run cy:run:regression-nightly",
    "cy:run:login": "cypress run --spec 'cypress/e2e/auth/login.cy.js'",
    "cy:run:compras": "cypress run --spec 'cypress/e2e/compras/*.cy.js'",
    "cy:run:compras:chrome": "cypress run --browser chrome --spec 'cypress/e2e/compras/*.cy.js'",
    "cy:run:compra-vitrine": "cypress run --spec 'cypress/e2e/compras/compraPorVitrine.cy.js'",
    "cy:run:compra-selecionando": "cypress run --spec 'cypress/e2e/compras/compraSelecionandoItens.cy.js'",
    "cy:run:compra-historico": "cypress run --spec 'cypress/e2e/compras/compraPorHistorico.cy.js'",
    "cy:run:compra-historico-revisar": "cypress run --spec 'cypress/e2e/compras/compraHistoricoRevisarPedido.cy.js'",
    "cy:run:compra-historico-finalize": "cypress run --spec 'cypress/e2e/compras/compraHistoricoFinalizePedido.cy.js'",
    "cy:run:compra-vitrine-dois-itens": "cypress run --spec 'cypress/e2e/compras/compraVitrineDoisItens.cy.js'",
    "cy:run:compra-vitrine-tres-itens": "cypress run --spec 'cypress/e2e/compras/compraVitrineTresItens.cy.js'",
    "cy:run:vitrine-mais-detalhes": "cypress run --spec 'cypress/e2e/compras/vitrineMaisDetalhes.cy.js'",
    "cy:run:vitrine-filtro-catalogo": "cypress run --spec 'cypress/e2e/compras/vitrineFiltroCatalogoFamilia.cy.js'",
    "cy:run:carrinho-voltar": "cypress run --spec 'cypress/e2e/compras/carrinhoNavegacaoVoltar.cy.js'",
    "cy:run:planilha-complementares": "cypress run --spec 'cypress/e2e/compras/planilhaUploadComplementares.cy.js'",
    "fixtures:planilhas": "node scripts/generate-planilha-fixtures.js",
    "cy:run:compra-planilha": "cypress run --spec 'cypress/e2e/compras/compraPorPlanilha.cy.js'",
    "cy:run:compra-corte-dobra": "cypress run --spec 'cypress/e2e/compras/compraCorteEDobra.cy.js'",
    "cy:run:compra-finalizacao": "cypress run --spec 'cypress/e2e/compras/compraFinalizacaoCompleta.cy.js'",
    "cy:run:compra-sem-emissor": "cypress run --spec 'cypress/e2e/compras/compraSemEmissor.cy.js'",
    "cy:run:p0": "cypress run --spec 'cypress/e2e/auth/login.cy.js,cypress/e2e/compras/compraPorVitrine.cy.js,cypress/e2e/compras/compraPorHistorico.cy.js,cypress/e2e/compras/compraSelecionandoItens.cy.js,cypress/e2e/compras/compraPorPlanilha.cy.js,cypress/e2e/compras/compraFinalizacaoCompleta.cy.js,cypress/e2e/compras/compraSemEmissor.cy.js'",
    "cy:run:p1": "cypress run --browser chrome --spec 'cypress/e2e/pedidos/*.cy.js'",
    "cy:run:pedidos": "cypress run --browser chrome --spec 'cypress/e2e/pedidos/*.cy.js'",
    "cy:run:p1-compras-opcional": "cypress run --browser chrome --spec 'cypress/e2e/compras/carrinhoPersistencia.cy.js,cypress/e2e/compras/buscaSemResultados.cy.js'",
    "cy:run:p0-p1": "cypress run --browser chrome --spec 'cypress/e2e/auth/login.cy.js,cypress/e2e/compras/compraPorVitrine.cy.js,cypress/e2e/compras/compraPorHistorico.cy.js,cypress/e2e/compras/compraSelecionandoItens.cy.js,cypress/e2e/compras/compraPorPlanilha.cy.js,cypress/e2e/compras/compraFinalizacaoCompleta.cy.js,cypress/e2e/compras/compraSemEmissor.cy.js,cypress/e2e/pedidos/*.cy.js'",
    "cy:run:menu": "cypress run --spec \"cypress/e2e/menu/*.cy.js\"",
    "cy:run:navegacao-cross": "cypress run --spec \"cypress/e2e/menu/navegacaoCruzadaComprasPedidos.cy.js\"",
    "cy:run:financas": "cypress run --spec 'cypress/e2e/financas/financasBusca.cy.js'",
    "cy:run:documentos": "cypress run --spec 'cypress/e2e/documentos/documentosBusca.cy.js'",
    "cy:run:operacional-modulos": "cypress run --spec \"cypress/e2e/menu/*.cy.js,cypress/e2e/pedidos/*.cy.js,cypress/e2e/financas/financasBusca.cy.js,cypress/e2e/documentos/documentosBusca.cy.js\"",
    "cy:run:smoke-pr": "cypress run --spec 'cypress/e2e/auth/login.cy.js,cypress/e2e/compras/compraPorVitrine.cy.js,cypress/e2e/compras/compraPorHistorico.cy.js'",
    "cy:run:regression-nightly": "cypress run --spec \"cypress/e2e/auth/login.cy.js,cypress/e2e/compras/compraPorVitrine.cy.js,cypress/e2e/compras/compraPorHistorico.cy.js,cypress/e2e/compras/compraSelecionandoItens.cy.js,cypress/e2e/compras/compraPorPlanilha.cy.js,cypress/e2e/compras/compraFinalizacaoCompleta.cy.js,cypress/e2e/compras/compraSemEmissor.cy.js,cypress/e2e/pedidos/*.cy.js,cypress/e2e/menu/*.cy.js,cypress/e2e/financas/financasBusca.cy.js,cypress/e2e/documentos/documentosBusca.cy.js\"",
    "cy:run:auth": "cypress run --spec 'cypress/e2e/auth/*.cy.js'",
    "allure:generate": "node scripts/allure-cli.js generate allure-results --clean -o allure-report",
    "allure:open": "node scripts/allure-cli.js open allure-report",
    "allure:serve": "node scripts/allure-cli.js serve allure-results",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "cy:run:allure": "npm run cy:run && npm run allure:generate",
    "test": "npm run cy:run && npm run allure:generate"
  },
  "keywords": [
    "cypress",
    "e2e",
    "automation",
    "gerdau"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "allure-commandline": "^2.34.1",
    "allure-cypress": "^3.4.1",
    "cypress": "^14.5.4",
    "cypress-plugin-xhr-toggle": "^1.2.1",
    "cypress-xpath": "^2.0.1",
    "xlsx": "^0.18.5"
  }
}
